datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-py"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  username  String
  password  String
  role      Role     @default(PLAYER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

enum Role {
  PLAYER
  ADMIN
}
