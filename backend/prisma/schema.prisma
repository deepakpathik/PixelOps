datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-py"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  username  String
  password  String
  role      Role     @default(PLAYER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  
  scores    Score[]
  wallet    Wallet?
  tournamentParticipants TournamentParticipant[]
}

enum Role {
  PLAYER
  ADMIN
}

model Game {
  id          String   @id @default(uuid())
  title       String
  description String?
  format      GameFormat
  isActive    Boolean  @default(true)
  developerId String
  createdAt   DateTime @default(now())

  versions    GameVersion[]
  scores      Score[]
  tournaments Tournament[]
}

model GameVersion {
  id        String   @id @default(uuid())
  gameId    String
  version   String
  fileUrl   String
  createdAt DateTime @default(now())

  game      Game @relation(fields: [gameId], references: [id])
}

enum GameFormat {
  HTML5
  WEBGL
  IFRAME
}

model Score {
  id        String   @id @default(uuid())
  userId    String
  gameId    String
  value     Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  game Game @relation(fields: [gameId], references: [id])
  fraudFlags FraudFlag[]
}

model Wallet {
  id      String @id @default(uuid())
  userId  String @unique
  balance Float  @default(0)

  user User @relation(fields: [userId], references: [id])
  transactions Transaction[]
}

model Transaction {
  id        String   @id @default(uuid())
  walletId  String
  type      String
  amount    Float
  createdAt DateTime @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id])
}

model Tournament {
  id        String   @id @default(uuid())
  name      String
  gameId    String
  status    TournamentStatus @default(CREATED)
  entryFee  Float
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())

  game Game @relation(fields: [gameId], references: [id])
  participants TournamentParticipant[]
  matches Match[]
}

model TournamentParticipant {
  id           String @id @default(uuid())
  tournamentId String
  userId       String

  tournament Tournament @relation(fields: [tournamentId], references: [id])
  user User @relation(fields: [userId], references: [id])
}

enum TournamentStatus {
  CREATED
  OPEN
  ONGOING
  COMPLETED
  ARCHIVED
}

model Match {
  id            String @id @default(uuid())
  tournamentId  String
  round         Int
  player1Id     String
  player2Id     String
  winnerId      String?

  tournament Tournament @relation(fields: [tournamentId], references: [id])
}

model FraudFlag {
  id        String @id @default(uuid())
  scoreId   String
  reason    String
  status    String @default("PENDING")

  score Score @relation(fields: [scoreId], references: [id])
}

model Notification {
  id        String @id @default(uuid())
  userId    String
  message   String
  isRead    Boolean @default(false)
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String @id @default(uuid())
  userId    String
  action    String
  entity    String
  createdAt DateTime @default(now())
}
